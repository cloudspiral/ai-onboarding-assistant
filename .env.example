# Shared
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Supabase (use a dedicated project; never reuse another application's project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI - all calls are made by apps/api/app/services/ai_client.rb
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=2800
OPENAI_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=180

# API/database
DATABASE_URL=postgresql://postgres:postgres@db:5432/harbor_development
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
SECRET_KEY_BASE=replace-me
AUTH_MODE=supabase

# Optional. If unset, the UI correctly says no email was sent.
MAIL_FROM=
SMTP_URL=

# Seed-only permanent reviewer accounts
REVIEWER_EMAIL=reviewer@harbor.example
REVIEWER_PASSWORD=
ADMIN_EMAIL=admin@harbor.example
ADMIN_PASSWORD=
